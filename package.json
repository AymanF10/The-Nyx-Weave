  "scripts": {
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check",
    "setup:devnet": "ts-node simulate/0_setup_devnet.ts",
    "test:er": "ANCHOR_PROVIDER_URL=https://api.devnet.solana.com ANCHOR_WALLET=arbitrage-wallet.json ts-mocha -p ./tsconfig.json -t 1000000 tests/er-delegation-commit.ts",
    "test:er:full": "ts-node tests/run-er-tests.ts",
    "sim:setup": "ts-node simulate/0_setup_devnet.ts",
    "sim:create-strategy": "ts-node simulate/2_create_strategy.ts",
    "sim:deposit": "ts-node simulate/2_deposit.ts",
    "sim:withdraw": "ts-node simulate/3_withdraw.ts",
    "sim:arbitrage": "ts-node simulate/4_execute_arbitrage.ts",
    "sim:claim": "ts-node simulate/5_claim_profits.ts",
    "sim:balances": "ts-node simulate/6_check_balances.ts",
    "sim:all": "ts-node simulate/run_all.ts",
    "sim:sequence": "npm run sim:setup && npm run sim:create-strategy && npm run sim:deposit && npm run sim:arbitrage && npm run sim:claim && npm run sim:balances"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@magicblock-labs/ephemeral-rollups-sdk": "^0.2.5",
    "@solana/spl-token": "^0.4.13"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "@types/node": "^24.0.3",
    "chai": "^4.3.4",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
